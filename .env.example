# Copy to .env.local and fill in. Never commit the real values.
DEEPSEEK_API_KEY=sk-...

# Vouchers. The codes are derived from this secret, so the same secret always
# regenerates the same list. Leave unset to disable vouchers entirely.
VOUCHER_SECRET=
# VOUCHER_QUESTIONS=10
# VOUCHER_COUNT=100

# Storage. Locally this is a real SQLite file and needs nothing set.
# A serverless host has no durable filesystem, so point it at libSQL (Turso),
# which is the same SQLite engine over HTTP. TURSO_* names also work.
# LIBSQL_URL=libsql://your-db.turso.io
# LIBSQL_AUTH_TOKEN=
# SQLITE_PATH=data/vachanamrut.db

# Legacy shared password. Ignored once VOUCHER_SECRET is set.
APP_PASSWORD=

# Optional overrides
# DEEPSEEK_MODEL=deepseek-reasoner
# DEEPSEEK_FALLBACK_MODEL=deepseek-chat
# ANSWER_DEADLINE_S=150
# HISTORY_MAX=1000
