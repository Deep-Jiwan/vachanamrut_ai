# Copy to .env.local and fill in. Never commit the real values.
DEEPSEEK_API_KEY=sk-...

# Vouchers. The 100 codes are derived from this secret, so the same secret
# always regenerates the same list. Leave unset to disable vouchers entirely.
VOUCHER_SECRET=
# VOUCHER_QUESTIONS=10
# VOUCHER_COUNT=100

# Durable storage for voucher balances and the shared history.
# Vercel KV injects these automatically; Upstash names are also accepted.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Legacy shared password. Ignored once VOUCHER_SECRET is set.
APP_PASSWORD=

# Optional overrides
# DEEPSEEK_MODEL=deepseek-reasoner
# DEEPSEEK_FALLBACK_MODEL=deepseek-chat
# ANSWER_DEADLINE_S=150
# HISTORY_MAX=1000
