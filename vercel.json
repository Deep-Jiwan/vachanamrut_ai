{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "**"
    }
  },
  "rewrites": [
    {
      "source": "/api/ask",
      "destination": "/api/index"
    },
    {
      "source": "/api/login",
      "destination": "/api/index"
    },
    {
      "source": "/api/health",
      "destination": "/api/index"
    }
  ]
}
